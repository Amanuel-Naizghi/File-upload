<!DOCTYPE html>
<html>
<head>
  <title>Folders</title>
</head>
<body>

  <ul>
    <% folders.forEach(f => { %>
      <li>
        <a href="/folders/<%= f.id %>">📁 <%= f.name %></a>
      </li>
    <% }) %>
  </ul>

  <h2>Files:</h2>
  <ul>
    <% files.forEach(file => { %>
      <li>📄 <%= file.filename %></li>
    <% }) %>
  </ul>

  <!-- The Modal -->
  <div id="myModal" class="modal">
    <div class="modal-content">
      <span id="closeModalBtn" class="close">&times;</span>
      <h2>Sign Up</h2>
      <form action="/folders" method="post">
        <label>Folder name</label><br>
        <input type="hidden" name="parentId" value="<%= folder ? folder.id : '' %>">
        <input type="text" name="folderName" placeholder="New Folder Name" required>
        <button type="submit">Submit</button>
      </form>
    </div>
  </div>


  <% if (folder && folder.parentId) { %>
    <p><a href="/folders/<%= folder.parentId %>">⬅️ Back</a></p>
  <% } else { %>
    <p><a href="/folders/root">⬅️ Back to Root</a></p>
  <% } %>

  <script>
    const modal = document.getElementById("myModal");
    const newFolder = document.getElementById("newFolder");
    const closeBtn = document.getElementById("closeModalBtn");

    // Open modal
    newFolder.onclick = function() {
      modal.style.display = "block";
    }

    // Close modal
    closeBtn.onclick = function() {
      modal.style.display = "none";
    }

    // Close modal if clicking outside of it
    window.onclick = function(event) {
      if (event.target === modal) {
        modal.style.display = "none";
      }
    }
  </script>
</body>
</html>
