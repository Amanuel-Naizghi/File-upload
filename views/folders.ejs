<!DOCTYPE html>
<html>
<head>
  <title>Folders</title>
  <style>
    .modal{
        display:none;
    }
    .modal2{
        display:none;
    }
    .edit-delete-container{
        display:none;
    }
  </style>
</head>
<body>
  <div class="directory-locator">
    <% if(directoryArray.length > 0){ %>
        <% directoryArray.forEach(item =>{%>
            <% if(item.name === 'root'){ %>
                <a href="/folders/root"><%= item.name %></a>
            <%}%>
            <% if(item.name !== 'root') { %>
                <a href="/folders/<%= item.id %>"><%= item.name %></a>
            <%}%>
        <%});%>
    <%}%>
    
  </div>
  <div class="folders-container">
    <ul>
        <% folders.forEach(f => { %>
          <li>
            <a href="/folders/<%= f.id %>">📁 <%= f.name %></a>
            <button class="edit-delete" id="<%= f.name %>" data-id="<%= f.id %>">☰</button>
            <div class="edit-delete-container" id="<%= f.id %>">
                <form action="/delete/<%= f.id %>" method="post">
                    <input type="hidden" name="id" value="<%= f.id %>">
                    <input type="hidden" name="parentId" value="<%= f.parentId ? f.parentId : 'root' %>">
                    <button id="delete" class="delete">Delete</button>
                </form>
                <button data-name="<%= f.name %>" data-id="<%= f.id %>" data-parent-id="<%= f.parentId ? f.parentId : 'root' %>" id="edit" class="edit-btn" >Edit</button>              
            </div>
          </li>
        <% }) %>
      </ul>
  </div>

  <h2>Files:</h2>
  <ul>
    <% files.forEach(file => { %>
      <li>📄 <%= file.filename %></li>
    <% }) %>
  </ul>

  <!-- The Modal for creating a folder -->
  <button id="newFolder">New Folder</button>
  <div id="myModal" class="modal">
    <div class="modal-content">
      <span id="closeModalBtn" class="close">&times;</span>
      <form action="/folders" method="post">
        <label>Folder name</label><br>
        <input type="hidden" name="parentId" value="<%= folder ? folder.id : '' %>">
        <input type="text" name="folderName" placeholder="New Folder Name" required>
        <button type="submit">Submit</button>
      </form>
    </div>
  </div>

  <!-- The Modal for editing a folder -->
  <div id="myModal2" class="modal2">
    <div class="modal-content2">
      <span id="closeModalBtn2" class="close2">&times;</span>
      <form action="/editFolder" method="post">
        <input type="hidden" name="id" id="editFolderId" >
        <input type="hidden" name="parentId" id="editFolderParentId" >
        <input type="text" name="name" id="editFolderName" class="form-control" required>
        <button type="submit">Submit</button>
      </form>
    </div>
  </div>

  <a href="javascript:history.back()">Back to previous page</a>

  <script src="/js/script.js"></script>

</body>
</html>
