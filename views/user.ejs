<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <p>User page is here</p>
    <div>
        <% if (locals.data) {%>
            <% data.folders.forEach((item) => { %>
                <div><%= item.name %></div>
            <%})%>
            <% data.files.forEach((item) => { %>
                <div><%= item.filename %></div>
            <%})%>
        <%}%>
    </div>
</body>
</html>